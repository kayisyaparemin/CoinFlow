<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoinFlow.App.ViewModels"
             x:Class="CoinFlow.App.Pages.MainPage"
             x:DataType="vm:DashboardViewModel"
             Title="Özet">
    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="20,28,20,40" Spacing="16">
                <Label Text="MERHABA" Style="{StaticResource Eyebrow}" />
                <Label Text="CoinFlow" Style="{StaticResource PageTitle}" />

                <Border IsVisible="{Binding NeedsSnapshot}" BackgroundColor="{StaticResource SoftPink}" StrokeThickness="0">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Gerçek bakiyeni birlikte başlatalım" Style="{StaticResource SectionTitle}" />
                        <Label Text="Şu anda zorunlu ödemelerin dışında harcayabileceğin serbest parayı aşağıya gir. Bu banka hesabının toplam bakiyesi değildir." Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="ŞU AN" Style="{StaticResource Eyebrow}" />
                <Border BackgroundColor="{StaticResource HeroSurface}" StrokeThickness="0" Padding="20">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="SERBEST PARA" Style="{StaticResource Eyebrow}" TextColor="{StaticResource PrimaryDeep}" />
                        <Label Text="{Binding CurrentAvailable}" Style="{StaticResource HeroNumber}" TextColor="{StaticResource PrimaryDeep}" />
                        <Label Text="{Binding CurrentPeriodText}" Style="{StaticResource MutedText}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                            <VerticalStackLayout>
                                <Label Text="MAAŞA" Style="{StaticResource Eyebrow}" />
                                <Label Text="{Binding DaysRemaining}" FontFamily="OpenSansSemibold" FontSize="22" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="DAILY REWARD" Style="{StaticResource Eyebrow}" />
                                <Label Text="{Binding DailyReward}" FontFamily="OpenSansSemibold" FontSize="22" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout>
                                <Label Text="SÜRDÜRÜLEBİLİR COIN" Style="{StaticResource Eyebrow}" />
                                <Label Text="{Binding SustainableDaily}" FontFamily="OpenSansSemibold" FontSize="20" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="COIN HAVUZU" Style="{StaticResource Eyebrow}" />
                                <Label Text="{Binding CoinPool}" FontFamily="OpenSansSemibold" FontSize="20" />
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="{Binding Encouragement}" TextColor="{StaticResource InkSoft}" FontSize="13" />
                        <ProgressBar Progress="{Binding Progress}" />
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding HasUpcomingCardPayment}"
                        BackgroundColor="{StaticResource SoftLavender}"
                        StrokeThickness="0">
                    <VerticalStackLayout Spacing="9">
                        <Label Text="YAKLAŞAN KART ÖDEMESİ" Style="{StaticResource Eyebrow}" />
                        <Label Text="{Binding UpcomingCardName}" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="7">
                            <Label Text="Ekstre" Style="{StaticResource MutedText}" />
                            <Label Grid.Column="1" Text="{Binding UpcomingStatementAmount}" FontFamily="OpenSansSemibold" />
                            <Label Grid.Row="1" Text="Asgari" Style="{StaticResource MutedText}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding UpcomingMinimumPayment}" FontFamily="OpenSansSemibold" />
                            <Label Grid.Row="2" Text="Son ödeme" Style="{StaticResource MutedText}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding UpcomingDueDate}" FontFamily="OpenSansSemibold" />
                            <Label Grid.Row="3" Text="Plan" Style="{StaticResource MutedText}" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding UpcomingPlan}" FontFamily="OpenSansSemibold" />
                        </Grid>
                        <Label Text="Bu ekstre için ödeme planla" Style="{StaticResource FieldLabel}" Margin="0,4,0,0" />
                        <Picker ItemsSource="{Binding UpcomingPaymentTypes}"
                                SelectedItem="{Binding SelectedUpcomingPaymentType}" />
                        <Entry Text="{Binding UpcomingCustomAmount}"
                               IsVisible="{Binding IsUpcomingCustomPayment}"
                               Placeholder="Özel tutar"
                               Keyboard="Numeric" />
                        <Button Text="Ödeme planını kaydet"
                                Command="{Binding SaveUpcomingCardPaymentCommand}" />
                        <Button Text="Daha sonra belirle"
                                Command="{Binding DeferUpcomingCardPaymentCommand}"
                                Style="{StaticResource SecondaryButton}" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource SoftSky}" StrokeThickness="0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Serbest bakiyeyi düzelt" Style="{StaticResource SectionTitle}" />
                        <Label Text="Bu tarih itibarıyla zorunlu ödemeler ayrıldıktan sonra gerçekten harcayabileceğin tutar." Style="{StaticResource MutedText}" />
                        <Entry Text="{Binding CorrectionAmount}" Placeholder="Şu an harcanabilir para" Keyboard="Numeric" />
                        <DatePicker Date="{Binding CorrectionDate}" Format="dd.MM.yyyy" />
                        <Entry Text="{Binding CorrectionNote}" Placeholder="Not (opsiyonel)" />
                        <Button Text="Serbest bakiyeyi kaydet" Command="{Binding CorrectBalanceCommand}" Style="{StaticResource SecondaryButton}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="SONRAKİ MAAŞ DÖNEMİ" Style="{StaticResource Eyebrow}" Margin="0,8,0,0" />
                <Border>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding NextPeriodText}" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="9">
                            <Label Text="Maaş" Style="{StaticResource MutedText}" />
                            <Label Grid.Column="1" Text="{Binding NextSalary}" FontFamily="OpenSansSemibold" />
                            <Label Grid.Row="1" Text="Beklenen zorunlu ödemeler" Style="{StaticResource MutedText}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding NextObligations}" FontFamily="OpenSansSemibold" />
                            <Label Grid.Row="2" Text="Tahmini serbest bütçe" Style="{StaticResource MutedText}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding NextBudget}" FontFamily="OpenSansSemibold" TextColor="{StaticResource MintStrong}" />
                            <Label Grid.Row="3" Text="Tahmini başlangıç Daily Coin" Style="{StaticResource MutedText}" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding NextDailyCoin}" FontFamily="OpenSansSemibold" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border>
                    <VerticalStackLayout Spacing="7">
                        <Label Text="ACİL DURUM TAMPONU" Style="{StaticResource Eyebrow}" />
                        <Label Text="{Binding EmergencyFund}" FontFamily="OpenSansSemibold" FontSize="18" />
                        <Label Text="Planlanan katkı zorunlu ödemede bir kez rezerve edilir." Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding IsDevelopment}" BackgroundColor="{StaticResource SoftLavender}" StrokeThickness="0">
                    <VerticalStackLayout Spacing="7">
                        <Label Text="HESAP DETAYLARI • DEVELOPMENT" Style="{StaticResource Eyebrow}" />
                        <Label Text="{Binding CalculationDetails}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding StatusMessage}" TextColor="{StaticResource Error}" IsVisible="{Binding HasStatus}" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
