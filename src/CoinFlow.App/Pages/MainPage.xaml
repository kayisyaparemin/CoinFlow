<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoinFlow.App.Pages.MainPage"
             Title="Ana Sayfa">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,36" Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="PLANLA • SİMÜLE ET • KARAR VER" Style="{StaticResource Eyebrow}" />
                    <Label Text="Ana Sayfa" Style="{StaticResource PageTitle}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="Ayarlar"
                        Command="{Binding OpenSettingsCommand}"
                        Padding="14,8"
                        MinimumHeightRequest="42"
                        VerticalOptions="Center" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Border BackgroundColor="{StaticResource HeroSurface}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="BU MAAŞ DÖNEMİ" Style="{StaticResource Eyebrow}" />
                    <Label Text="{Binding CurrentPeriodText}" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding AssignmentModeText}" FontFamily="OpenSansSemibold" />
                    <Label Text="{Binding PaymentWindowText}" Style="{StaticResource MutedText}" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                        <Label Text="Gelir" Style="{StaticResource MutedText}" />
                        <Label Grid.Column="1" Text="{Binding Income}" FontFamily="OpenSansSemibold" />
                        <Label Grid.Row="1" Text="Zorunlu ödemeler" Style="{StaticResource MutedText}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Mandatory}" />
                        <Label Grid.Row="2" Text="Zorunlular sonrası alan" FontFamily="OpenSansSemibold" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Available}" FontFamily="OpenSansSemibold" />
                        <Label Grid.Row="3" Text="Tahmini yaşam gideri" Style="{StaticResource MutedText}" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding Living}" />
                        <Label Grid.Row="4" Text="Tahmini tasarruf" FontFamily="OpenSansSemibold" />
                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding EstimatedSavings}" FontFamily="OpenSansSemibold" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                    <Label Text="Tahmini dönem sonu birikim" Style="{StaticResource MutedText}" />
                    <Label Text="{Binding EndingSavings}" Style="{StaticResource HeroNumber}" />
                    <Label Text="{Binding DeficitMessage}" TextColor="{StaticResource Error}" IsVisible="{Binding HasDeficit}" />
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding HasUndeterminedCardPayment}" BackgroundColor="{StaticResource SoftPink}">
                <Label Text="Bazı kart ödemeleri henüz seçilmedi. Bu dönemlerin projeksiyonu eksik olabilir." />
            </Border>

            <VerticalStackLayout Spacing="10">
                <Label Text="Yaklaşan Büyük Ödemeler" Style="{StaticResource SectionTitle}" />
                <Label Text="Yaklaşan exact-date ödeme bulunmuyor."
                       Style="{StaticResource MutedText}"
                       IsVisible="{Binding HasNoUpcomingPayments}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding UpcomingPayments}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14">
                                <Grid ColumnDefinitions="70,*,Auto" RowDefinitions="Auto,Auto">
                                    <Label Text="{Binding Date}" FontFamily="OpenSansSemibold" />
                                    <Label Grid.Column="1" Text="{Binding Name}" FontFamily="OpenSansSemibold" />
                                    <Label Grid.Column="2" Text="{Binding Amount}" FontFamily="OpenSansSemibold" />
                                    <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Detail}" Style="{StaticResource MutedText}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Border BackgroundColor="{StaticResource SoftSky}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="12 AYLIK GÖRÜNÜM" Style="{StaticResource Eyebrow}" />
                    <Label Text="12 dönem sonunda tahmini birikim" Style="{StaticResource MutedText}" />
                    <Label Text="{Binding TwelveMonthSavings}" Style="{StaticResource HeroNumber}" />
                    <Label Text="En sıkışık dönem" Style="{StaticResource MutedText}" />
                    <Label Text="{Binding TightestPeriod}" FontFamily="OpenSansSemibold" />
                    <Label Text="{Binding TightestValue}" />
                    <Button Text="Simülasyon Yap" Command="{Binding OpenSimulationCommand}" />
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding IsDevelopment}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="HESAPLAMA DETAYLARI • DEVELOPMENT" Style="{StaticResource Eyebrow}" />
                    <Label Text="{Binding CalculationDetails}" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}" TextColor="{StaticResource Error}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
