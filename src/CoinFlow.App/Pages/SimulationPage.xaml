<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoinFlow.App.ViewModels"
             xmlns:models="clr-namespace:CoinFlow.App.Models"
             x:Class="CoinFlow.App.Pages.SimulationPage"
             x:DataType="vm:SimulationViewModel"
             Title="Simülasyon">
    <ScrollView>
        <VerticalStackLayout Padding="20,28,20,40" Spacing="14">
            <Label Text="ÖNCE DENE" Style="{StaticResource Eyebrow}" />
            <Label Text="Yeni borç simülasyonu" Style="{StaticResource PageTitle}" />
            <Label Text="Bu hesap gerçek borç oluşturmaz; 12 aylık serbest para etkisini gösterir." Style="{StaticResource MutedText}" />
            <Border>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Alışveriş adı" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Name}" />
                    <Label Text="Toplam tutar" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding TotalAmount}" Keyboard="Numeric" />
                    <Label Text="Taksit sayısı" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding InstallmentCount}" Keyboard="Numeric" />
                    <Label Text="İlk ödeme ayı" Style="{StaticResource FieldLabel}" />
                    <DatePicker Date="{Binding FirstPaymentDate}" Format="MMMM yyyy" />
                    <Button Text="12 aylık etkiyi hesapla" Command="{Binding CalculateCommand}" Style="{StaticResource SecondaryButton}" />
                </VerticalStackLayout>
            </Border>
            <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}" TextColor="{StaticResource Error}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <CollectionView ItemsSource="{Binding Results}" SelectionMode="None" HeightRequest="720">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SimulationLine">
                        <Border Margin="0,0,0,10" Padding="14">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Month}" FontFamily="OpenSansSemibold" FontSize="17" />
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <Label Text="Mevcut serbest para" Style="{StaticResource MutedText}" />
                                    <Label Grid.Column="1" Text="{Binding Baseline}" />
                                    <Label Grid.Row="1" Text="Yeni taksit" Style="{StaticResource MutedText}" />
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Installment}" />
                                    <Label Grid.Row="2" Text="Simülasyon sonrası" FontFamily="OpenSansSemibold" />
                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding Result}" FontFamily="OpenSansSemibold" TextColor="{StaticResource MintStrong}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
