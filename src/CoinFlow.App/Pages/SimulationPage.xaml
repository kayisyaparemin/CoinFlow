<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoinFlow.App.Pages.SimulationPage"
             Title="Simülatör">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,36" Spacing="16">
            <Label Text="PLANLAMADAN ÖNCE DENE" Style="{StaticResource Eyebrow}" />
            <Label Text="Simülatör" Style="{StaticResource PageTitle}" />
            <Label Text="Baseline ve yeni plan aynı 12 dönem projection engine'iyle hesaplanır. Simüle Et veritabanına kayıt yazmaz." Style="{StaticResource MutedText}" />
            <Label Text="{Binding AssignmentModeText}"
                   IsVisible="{Binding IsPlanAvailable}"
                   FontFamily="OpenSansSemibold" />

            <Border IsVisible="{Binding IsPlanUnavailable}"
                    BackgroundColor="{StaticResource SoftSky}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Simülasyon henüz kullanılamıyor."
                           Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding EmptyStateMessage}"
                           Style="{StaticResource MutedText}" />
                    <Button Text="Gelir &amp; Ödemelere Git"
                            Command="{Binding OpenCommitmentsCommand}" />
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding IsPlanAvailable}">
                <VerticalStackLayout Spacing="9">
                    <Label Text="Senaryo" Style="{StaticResource SectionTitle}" />
                    <Label Text="Senaryo türü" Style="{StaticResource FieldLabel}" />
                    <Picker ItemsSource="{Binding ScenarioTypes}" SelectedItem="{Binding SelectedScenarioType}" />
                    <Label Text="{Binding ScenarioDescription}" Style="{StaticResource MutedText}" />
                    <Label Text="Plan adı" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Name}" Placeholder="Örn. Beyaz eşya" />
                    <VerticalStackLayout IsVisible="{Binding IsRegularScenario}" Spacing="7">
                        <Label Text="Tutar" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding Amount}" Keyboard="Numeric" />
                        <Label Text="Başlangıç / işlem tarihi" Style="{StaticResource FieldLabel}" />
                        <DatePicker Date="{Binding StartDate}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsStrategyChange}" Spacing="7">
                        <Label Text="Yeni düzen" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding StrategyModes}"
                                SelectedItem="{Binding SelectedStrategyMode}" />
                        <Label Text="Geçerli olacağı maaş" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding StrategySalaryDates}"
                                SelectedItem="{Binding SelectedStrategySalaryDate}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsCard}" Spacing="7">
                        <Label Text="Kredi kartı" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding CreditCards}" SelectedItem="{Binding SelectedCreditCard}" Title="Kart seç" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding NeedsPaymentCount}" Spacing="7">
                        <Label Text="Ödeme / taksit sayısı" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding PaymentCount}" Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding NeedsFirstPayment}" Spacing="7">
                        <Label Text="İlk ödeme tarihi" Style="{StaticResource FieldLabel}" />
                        <DatePicker Date="{Binding FirstPaymentDate}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsFinancing}" Spacing="7">
                        <Label Text="Toplam geri ödeme" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding TotalRepaymentAmount}" Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <Button Text="Simüle Et" Command="{Binding CalculateCommand}" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}" TextColor="{StaticResource Error}" />

            <VerticalStackLayout IsVisible="{Binding HasResults}" Spacing="14">
                <Border BackgroundColor="{StaticResource SoftSky}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="KARAR ÖZETİ" Style="{StaticResource Eyebrow}" />
                        <Label Text="{Binding FriendlySummary}" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="7">
                            <Label Text="Mevcut plan • 12 dönem sonu" Style="{StaticResource MutedText}" />
                            <Label Grid.Column="1" Text="{Binding BaselineEnding}" />
                            <Label Grid.Row="1" Text="Yeni plan • 12 dönem sonu" Style="{StaticResource MutedText}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding ScenarioEnding}" FontFamily="OpenSansSemibold" />
                            <Label Grid.Row="2" Text="Fark" Style="{StaticResource MutedText}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding EndingDifference}" FontFamily="OpenSansSemibold" />
                            <Label Grid.Row="3" Text="Toplam senaryo maliyeti" Style="{StaticResource MutedText}" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding TotalScenarioCost}" />
                        </Grid>
                        <Grid IsVisible="{Binding HasFinancingCost}" ColumnDefinitions="*,Auto">
                            <Label Text="Finansman maliyeti" Style="{StaticResource MutedText}" />
                            <Label Grid.Column="1" Text="{Binding FinancingCost}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding HasStrategyTransitionSummary}" BackgroundColor="{StaticResource SoftPink}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Düzen Değişikliği Geçiş Yükü" Style="{StaticResource SectionTitle}" />
                        <Label Text="{Binding StrategyTransitionSummary}" />
                    </VerticalStackLayout>
                </Border>

                <Border>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Risk Özeti" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="7">
                            <Label Text="En sıkışık dönem" Style="{StaticResource MutedText}" />
                            <Label Grid.Column="1" Text="{Binding TightestPeriod}" />
                            <Label Grid.Row="1" Text="En düşük kullanılabilir alan" Style="{StaticResource MutedText}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding LowestAvailable}" />
                            <Label Grid.Row="2" Text="En düşük tasarruf kapasitesi" Style="{StaticResource MutedText}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding LowestSavingsCapacity}" />
                            <Label Grid.Row="3" Text="En düşük tahmini birikim" Style="{StaticResource MutedText}" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding LowestProjectedSavings}" />
                            <Label Grid.Row="4" Text="İlk finansman açığı dönemi" Style="{StaticResource MutedText}" />
                            <Label Grid.Row="4" Grid.Column="1" Text="{Binding FirstNegativePeriod}" />
                            <Label Grid.Row="5" Text="Maksimum devreden açık" Style="{StaticResource MutedText}" />
                            <Label Grid.Row="5" Grid.Column="1" Text="{Binding MaximumCarryOverDeficit}" />
                            <Label Grid.Row="6" Text="Açığın kapanacağı dönem" Style="{StaticResource MutedText}" />
                            <Label Grid.Row="6" Grid.Column="1" Text="{Binding RecoveryPeriod}" />
                        </Grid>
                        <Button Text="{Binding ApplyButtonText}"
                                IsEnabled="{Binding CanApplyPlan}"
                                Clicked="OnApplyPlanClicked"
                                Style="{StaticResource SecondaryButton}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Dönem Etkisi" Style="{StaticResource SectionTitle}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Results}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Period}" FontFamily="OpenSansSemibold" />
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                        <Label Text="Mevcut plan birikim" Style="{StaticResource MutedText}" />
                                        <Label Grid.Column="1" Text="{Binding BaselineSavings}" />
                                        <Label Grid.Row="1" Text="Yeni plan birikim" Style="{StaticResource MutedText}" />
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding ScenarioSavings}" />
                                        <Label Grid.Row="2" Text="Fark" Style="{StaticResource MutedText}" />
                                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Difference}" FontFamily="OpenSansSemibold" />
                                        <Label Grid.Row="3" Text="Zorunlular sonrası" Style="{StaticResource MutedText}" />
                                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding AvailableAfterMandatory}" />
                                        <Label Grid.Row="4" Text="Bu dönemin tahmini tasarrufu" Style="{StaticResource MutedText}" />
                                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding SavingsCapacity}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto"
                                          RowDefinitions="Auto,Auto"
                                          RowSpacing="4"
                                          IsVisible="{Binding HasCarryOverDeficit}">
                                        <Label Text="Devreden finansman açığı" TextColor="{StaticResource Error}" />
                                        <Label Grid.Column="1" Text="{Binding CarryOverDeficit}" TextColor="{StaticResource Error}" />
                                        <Label Grid.Row="1" Text="Açık sonrası kullanılabilir" Style="{StaticResource MutedText}" />
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding AvailableAfterCarryOverDeficit}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
