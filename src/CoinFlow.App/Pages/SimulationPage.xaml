<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoinFlow.App.Pages.SimulationPage"
             x:Name="PageRoot"
             Title="Simülatör">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,36" Spacing="16">
            <Label Text="PLANLAMADAN ÖNCE DENE" Style="{StaticResource Eyebrow}" />
            <Label Text="Simülatör" Style="{StaticResource PageTitle}" />
            <Label Text="Simülasyon Yap, finans kayıtlarını değiştirmeden seçtiğin planla oluşan 12 aylık görünümü hesaplar." Style="{StaticResource MutedText}" />
            <Label Text="{Binding AssignmentModeText}"
                   IsVisible="{Binding IsPlanAvailable}"
                   FontFamily="OpenSansSemibold" />

            <Border IsVisible="{Binding IsPlanUnavailable}"
                    BackgroundColor="{StaticResource SoftSky}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Simülasyon henüz kullanılamıyor."
                           Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding EmptyStateMessage}"
                           Style="{StaticResource MutedText}" />
                    <Button Text="Gelir &amp; Ödemelere Git"
                            Command="{Binding OpenCommitmentsCommand}" />
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding IsPlanAvailable}">
                <VerticalStackLayout Spacing="9">
                    <Label Text="Planı Dene" Style="{StaticResource SectionTitle}" />
                    <Label Text="Plan türü" Style="{StaticResource FieldLabel}" />
                    <Picker ItemsSource="{Binding ScenarioTypes}" SelectedItem="{Binding SelectedScenarioType}" />
                    <Label Text="{Binding ScenarioDescription}" Style="{StaticResource MutedText}" />
                    <Label Text="Plan adı" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Name}" Placeholder="Örn. Beyaz eşya" />
                    <VerticalStackLayout IsVisible="{Binding IsRegularScenario}" Spacing="7">
                        <VerticalStackLayout IsVisible="{Binding NeedsAmount}" Spacing="7">
                            <Label Text="Tutar" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding Amount}" Keyboard="Numeric" />
                        </VerticalStackLayout>
                        <Label Text="{Binding StartDateLabel}" Style="{StaticResource FieldLabel}" />
                        <DatePicker Date="{Binding StartDate}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsStrategyChange}" Spacing="7">
                        <Label Text="Yeni düzen" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding StrategyModes}"
                                SelectedItem="{Binding SelectedStrategyMode}" />
                        <Label Text="Geçerli olacağı maaş" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding StrategySalaryDates}"
                                SelectedItem="{Binding SelectedStrategySalaryDate}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsCard}" Spacing="7">
                        <Label Text="Kredi kartı" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding CreditCards}" SelectedItem="{Binding SelectedCreditCard}" Title="Kart seç" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding NeedsPaymentCount}" Spacing="7">
                        <Label Text="Ödeme / taksit sayısı" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding PaymentCount}" Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding NeedsFirstPayment}" Spacing="7">
                        <Label Text="İlk ödeme tarihi" Style="{StaticResource FieldLabel}" />
                        <DatePicker Date="{Binding FirstPaymentDate}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsFinancing}" Spacing="7">
                        <Label Text="Toplam geri ödeme" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding TotalRepaymentAmount}" Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <Button Text="{Binding AddConditionButtonText}"
                            Command="{Binding AddConditionCommand}" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}" TextColor="{StaticResource Error}" />

            <Border IsVisible="{Binding IsPlanAvailable}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="Simülasyon Planı" Style="{StaticResource SectionTitle}" />
                        <Label Grid.Column="1"
                               Text="{Binding DraftConditionCountText}"
                               Style="{StaticResource MutedText}" />
                    </Grid>
                    <Label Text="Önce denemek istediğin en az bir koşul ekle."
                           IsVisible="{Binding HasNoDraftConditions}"
                           Style="{StaticResource MutedText}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding DraftConditions}"
                                         IsVisible="{Binding HasDraftConditions}"
                                         Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12"
                                        BackgroundColor="{StaticResource ProjectionSurface}">
                                    <VerticalStackLayout Spacing="7">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="3">
                                                <Label Text="{Binding DateText}"
                                                       FontFamily="OpenSansSemibold" />
                                                <Label Text="{Binding SummaryText}"
                                                       Style="{StaticResource MutedText}" />
                                                <Label Text="{Binding TypeText}"
                                                       FontSize="12"
                                                       TextColor="{StaticResource ProjectionText}" />
                                            </VerticalStackLayout>
                                            <HorizontalStackLayout Grid.Column="1"
                                                                   Spacing="6"
                                                                   VerticalOptions="Center">
                                                <Button Text="Düzenle"
                                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.EditConditionCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Style="{StaticResource SecondaryButton}" />
                                                <Button Text="Sil"
                                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveConditionCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Style="{StaticResource SecondaryButton}" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Button Text="{Binding RunSimulationButtonText}"
                                Command="{Binding CalculateCommand}"
                                IsEnabled="{Binding CanRunSimulation}" />
                        <Button Grid.Column="1"
                                Text="Planı Temizle"
                                Command="{Binding ClearDraftCommand}"
                                IsVisible="{Binding HasMultipleDraftConditions}"
                                Style="{StaticResource SecondaryButton}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding HasStaleResult}"
                    BackgroundColor="{StaticResource WarningSurface}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Plan değişti."
                           Style="{StaticResource SectionTitle}" />
                    <Label Text="Yeni sonucu görmek için simülasyonu güncelle."
                           TextColor="{StaticResource WarningText}" />
                    <Button Text="Simülasyonu Güncelle"
                            Command="{Binding CalculateCommand}"
                            IsEnabled="{Binding CanRunSimulation}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout IsVisible="{Binding HasCurrentResults}" Spacing="14">
                <Border BackgroundColor="{StaticResource SoftSky}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="BU PLANLA ÖNÜNDE NE VAR?" Style="{StaticResource Eyebrow}" />
                        <Label Text="Bu planla önünde ne var?" Style="{StaticResource SectionTitle}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding NarrativeInsights}"
                                             Spacing="7">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding .}" Style="{StaticResource MutedText}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Ne zaman karşılayabilirim?"
                               Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Text="{Binding TargetAmount}"
                                   Placeholder="Hedef tutar"
                                   Keyboard="Numeric" />
                            <Button Grid.Column="1"
                                    Text="Hesapla"
                                    Command="{Binding FindTargetCommand}" />
                        </Grid>
                        <Label Text="{Binding TargetResult}"
                               IsVisible="{Binding HasTargetResult}" />
                    </VerticalStackLayout>
                </Border>

                <Border>
                    <VerticalStackLayout Spacing="11">
                        <Label Text="Öne Çıkanlar" Style="{StaticResource SectionTitle}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding SummaryMetrics}"
                                             Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="5">
                                        <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <Label Text="{Binding Label}" Style="{StaticResource MutedText}" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding Value}"
                                                   FontFamily="OpenSansSemibold"
                                                   TextColor="{StaticResource ProjectionText}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsDeficit}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource DeficitText}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSavings}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource PositiveText}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsMandatory}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource DebtText}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Grid>
                                        <Label Text="{Binding Detail}"
                                               IsVisible="{Binding HasDetail}"
                                               Style="{StaticResource MutedText}"
                                               FontSize="12" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Button Text="{Binding ApplyButtonText}"
                                IsEnabled="{Binding CanApplyPlan}"
                                Clicked="OnApplyPlanClicked"
                                Style="{StaticResource SecondaryButton}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="12 Aylık Finansal Görünüm" Style="{StaticResource SectionTitle}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Results}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenPeriodDetailCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="9">
                                    <Label Text="{Binding Period}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="17" />
                                    <Label Text="{Binding Assignment}"
                                           Style="{StaticResource MutedText}" />
                                    <Grid ColumnDefinitions="*,Auto"
                                          RowDefinitions="Auto,Auto,Auto,Auto"
                                          RowSpacing="6">
                                        <Label Text="Dönem gelirleri" Style="{StaticResource MutedText}" />
                                        <Label Grid.Column="1" Text="{Binding IncomeText}" />
                                        <Label Grid.Row="1" Text="Bu dönem gereken" Style="{StaticResource MutedText}" />
                                        <Label Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{Binding NeedText}"
                                               FontFamily="OpenSansSemibold" />
                                        <Label Grid.Row="2" Text="{Binding CoverageLabel}" Style="{StaticResource MutedText}" />
                                        <Label Grid.Row="2"
                                               Grid.Column="1"
                                               Text="{Binding CoverageAmountText}"
                                               FontFamily="OpenSansSemibold" />
                                        <Label Grid.Row="3" Text="Dönem sonu durumu" Style="{StaticResource MutedText}" />
                                        <Label Grid.Row="3"
                                               Grid.Column="1"
                                               Text="{Binding EndingText}"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="{StaticResource PositiveText}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding EndingIsNegative}"
                                                             Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource Error}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                    <FlexLayout Wrap="Wrap" Direction="Row">
                                        <Border Padding="9,4"
                                                Margin="0,0,6,3"
                                                IsVisible="{Binding HasPrimaryInsight}"
                                                BackgroundColor="{StaticResource WarningSurface}">
                                            <Label Text="{Binding PrimaryInsight}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource WarningText}" />
                                        </Border>
                                        <Border Padding="9,4"
                                                Margin="0,0,6,3"
                                                IsVisible="{Binding HasSecondaryInsight}"
                                                BackgroundColor="{StaticResource ProjectionSurface}">
                                            <Label Text="{Binding SecondaryInsight}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource ProjectionText}" />
                                        </Border>
                                    </FlexLayout>
                                    <Border Padding="9,4"
                                            HorizontalOptions="Start"
                                            IsVisible="{Binding Projection.HasUndeterminedCardPayment}"
                                            BackgroundColor="{StaticResource InterestSurface}">
                                        <Label Text="Kart ödeme planı bekliyor"
                                               FontSize="11"
                                               TextColor="{StaticResource InterestText}" />
                                    </Border>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Bu dönemde ne olacak?"
                                               Style="{StaticResource MutedText}" />
                                        <HorizontalStackLayout Grid.Column="1" Spacing="7">
                                            <Label Text="Detayı Gör"
                                                   FontFamily="OpenSansSemibold"
                                                   TextColor="{StaticResource ProjectionText}" />
                                            <Label Text="›"
                                                   FontSize="21"
                                                   VerticalTextAlignment="Center"
                                                   TextColor="{StaticResource ProjectionText}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
