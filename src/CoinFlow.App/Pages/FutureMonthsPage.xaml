<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoinFlow.App.Pages.FutureMonthsPage"
             Title="12 Aylık">
    <Grid RowDefinitions="Auto,*" Padding="20,18,20,12" RowSpacing="14">
        <VerticalStackLayout Spacing="10">
            <Label Text="12 MAAŞ DÖNEMİ" Style="{StaticResource Eyebrow}" />
            <Label Text="İleriye Bakış" Style="{StaticResource PageTitle}" />
            <Label Text="Gerçek ödeme tarihleri korunur; seçili maaş kullanım şekline göre ilgili maaş bütçesine atanır." Style="{StaticResource MutedText}" />
            <Border Padding="14" IsVisible="{Binding HasProjection}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Ne zaman karşılayabilirim?" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Text="{Binding TargetAmount}" Placeholder="Hedef tutar" Keyboard="Numeric" />
                        <Button Grid.Column="1" Text="Hesapla" Command="{Binding FindTargetCommand}" />
                    </Grid>
                    <Label Text="{Binding TargetResult}" IsVisible="{Binding HasTargetResult}" />
                </VerticalStackLayout>
            </Border>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}" TextColor="{StaticResource Error}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                IsVisible="{Binding HasNoProjection}"
                BackgroundColor="{StaticResource SoftSky}"
                VerticalOptions="Start">
            <VerticalStackLayout Spacing="10">
                <Label Text="Henüz projeksiyon yok."
                       Style="{StaticResource SectionTitle}" />
                <Label Text="{Binding EmptyStateMessage}"
                       Style="{StaticResource MutedText}" />
                <Button Text="Gelir &amp; Ödemelere Git"
                        Command="{Binding OpenCommitmentsCommand}" />
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="1"
                        IsVisible="{Binding HasProjection}"
                        ItemsSource="{Binding Periods}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="9">
                            <Label Text="{Binding Period}" FontFamily="OpenSansSemibold" FontSize="17" />
                            <Label Text="{Binding Assignment}" Style="{StaticResource MutedText}" />
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Zorunlular sonrası" Style="{StaticResource MutedText}" />
                                    <Label Grid.Column="1" Text="{Binding AvailableAfterMandatory}" FontFamily="OpenSansSemibold" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasCarryOverDeficit}">
                                    <Label Text="Devreden açık" TextColor="{StaticResource Error}" />
                                    <Label Grid.Column="1" Text="{Binding CarryOverDeficit}" TextColor="{StaticResource Error}" FontFamily="OpenSansSemibold" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasCarryOverDeficit}">
                                    <Label Text="Açık sonrası kullanılabilir" Style="{StaticResource MutedText}" />
                                    <Label Grid.Column="1" Text="{Binding AvailableAfterCarryOverDeficit}" FontFamily="OpenSansSemibold" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Tahmini yaşam" Style="{StaticResource MutedText}" />
                                    <Label Grid.Column="1" Text="{Binding LivingBudget}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasPlannedLargeCashExpenses}">
                                    <Label Text="Büyük planlı ödeme" Style="{StaticResource MutedText}" />
                                    <Label Grid.Column="1" Text="{Binding PlannedLargeCashExpenses}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Bu dönemin tahmini tasarrufu" Style="{StaticResource MutedText}" />
                                    <Label Grid.Column="1" Text="{Binding EstimatedSavings}" FontFamily="OpenSansSemibold" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Dönem sonu tahmini birikim" Style="{StaticResource MutedText}" />
                                    <Label Grid.Column="1" Text="{Binding EndingProjectedSavings}" FontFamily="OpenSansSemibold" />
                                </Grid>
                            </VerticalStackLayout>
                            <Label Text="{Binding CarryOverMessage}"
                                   IsVisible="{Binding HasCarryOverDeficit}"
                                   Style="{StaticResource MutedText}" />
                            <Label Text="{Binding Notice}" IsVisible="{Binding HasNotice}" TextColor="{StaticResource Error}" FontSize="12" />
                            <Label Text="Detay için dokun" Style="{StaticResource MutedText}" IsVisible="{Binding IsCollapsed}" />
                            <Label Text="{Binding Breakdown}" IsVisible="{Binding IsExpanded}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
