<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoinFlow.App.Pages.FutureMonthsPage"
             x:Name="PageRoot"
             Title="12 Aylık">
    <Grid RowDefinitions="Auto,*" Padding="20,18,20,12" RowSpacing="14">
        <VerticalStackLayout Spacing="10">
            <Label Text="FİNANSAL GÖRÜNÜM" Style="{StaticResource Eyebrow}" />
            <Label Text="12 Aylık" Style="{StaticResource PageTitle}" />
            <Label Text="Önümüzdeki 12 maaş döneminde finansal durumunun nasıl değişeceğini gör." Style="{StaticResource MutedText}" />
            <Border Padding="14"
                    IsVisible="{Binding HasInterestSummary}"
                    BackgroundColor="{StaticResource SoftPink}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="12 Aylık Tahmini Faiz Yükü" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
                        <Label Text="Kredi kartı" Style="{StaticResource MutedText}" />
                        <Label Grid.Column="1" Text="{Binding TotalCreditCardInterest}" />
                        <Label Grid.Row="1" Text="Finansman açığı" Style="{StaticResource MutedText}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding TotalDeficitInterest}" />
                        <Label Grid.Row="2" Text="Toplam tahmini faiz" FontFamily="OpenSansSemibold" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding TotalInterestCost}" FontFamily="OpenSansSemibold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Border Padding="14" IsVisible="{Binding HasProjection}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Ne zaman karşılayabilirim?" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Text="{Binding TargetAmount}" Placeholder="Hedef tutar" Keyboard="Numeric" />
                        <Button Grid.Column="1" Text="Hesapla" Command="{Binding FindTargetCommand}" />
                    </Grid>
                    <Label Text="{Binding TargetResult}" IsVisible="{Binding HasTargetResult}" />
                </VerticalStackLayout>
            </Border>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}" TextColor="{StaticResource Error}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                IsVisible="{Binding HasNoProjection}"
                BackgroundColor="{StaticResource SoftSky}"
                VerticalOptions="Start">
            <VerticalStackLayout Spacing="10">
                <Label Text="Henüz 12 aylık plan yok."
                       Style="{StaticResource SectionTitle}" />
                <Label Text="{Binding EmptyStateMessage}"
                       Style="{StaticResource MutedText}" />
                <Button Text="Gelir &amp; Ödemelere Git"
                        Command="{Binding OpenCommitmentsCommand}" />
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="1"
                        IsVisible="{Binding HasProjection}"
                        ItemsSource="{Binding Periods}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenPeriodDetailCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="11">
                            <Label Text="{Binding Period}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="18" />
                            <Label Text="{Binding Assignment}" Style="{StaticResource MutedText}" />
                            <VerticalStackLayout Spacing="7">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Zorunlular sonrası" Style="{StaticResource MutedText}" />
                                    <Label Grid.Column="1" Text="{Binding AvailableAfterMandatory}" FontFamily="OpenSansSemibold" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasCarryOverDeficit}">
                                    <Label Text="Devreden açık" TextColor="{StaticResource Error}" />
                                    <Label Grid.Column="1" Text="{Binding CarryOverDeficit}" TextColor="{StaticResource Error}" FontFamily="OpenSansSemibold" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Dönem neti" Style="{StaticResource MutedText}" />
                                    <Label Grid.Column="1" Text="{Binding EstimatedSavings}" FontFamily="OpenSansSemibold" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Dönem sonu durumu" Style="{StaticResource MutedText}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding EndingProjectedSavings}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="16" />
                                </Grid>
                            </VerticalStackLayout>
                            <FlexLayout Wrap="Wrap" Direction="Row">
                                <Border Padding="9,4"
                                        Margin="0,0,6,5"
                                        IsVisible="{Binding HasBeforeSalaryWarning}"
                                        BackgroundColor="{StaticResource WarningSurface}">
                                    <Label Text="{Binding BeforeSalaryWarning}"
                                           FontSize="11"
                                           TextColor="{StaticResource WarningText}" />
                                </Border>
                                <Border Padding="9,4"
                                        Margin="0,0,6,5"
                                        IsVisible="{Binding HasInterest}"
                                        BackgroundColor="{StaticResource InterestSurface}">
                                    <Label Text="{Binding TotalInterest, StringFormat='Faiz yükü: {0}'}"
                                           FontSize="11"
                                           TextColor="{StaticResource InterestText}" />
                                </Border>
                                <Border Padding="9,4"
                                        Margin="0,0,6,5"
                                        IsVisible="{Binding HasEstimatedPayment}"
                                        BackgroundColor="{StaticResource ProjectionSurface}">
                                    <Label Text="Tahmini kart ödemesi"
                                           FontSize="11"
                                           TextColor="{StaticResource ProjectionText}" />
                                </Border>
                                <Border Padding="9,4"
                                        Margin="0,0,6,5"
                                        IsVisible="{Binding HasUndeterminedPayment}"
                                        BackgroundColor="{StaticResource WarningSurface}">
                                    <Label Text="Kart ödemesi belirlenmedi"
                                           FontSize="11"
                                           TextColor="{StaticResource WarningText}" />
                                </Border>
                            </FlexLayout>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Detayı Gör"
                                       HorizontalOptions="End"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource ProjectionText}" />
                                <Label Grid.Column="1"
                                       Text="›"
                                       Margin="8,0,0,0"
                                       FontSize="21"
                                       VerticalTextAlignment="Center"
                                       TextColor="{StaticResource ProjectionText}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
