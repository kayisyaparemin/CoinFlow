<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoinFlow.App.Pages.SettingsPage"
             Title="Ayarlar">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,36" Spacing="16">
            <Label Text="PROJEKSİYON AYARLARI" Style="{StaticResource Eyebrow}" />
            <Label Text="Ayarlar" Style="{StaticResource PageTitle}" />

            <Border>
                <VerticalStackLayout Spacing="9">
                    <Label Text="Maaş Dönemi" Style="{StaticResource SectionTitle}" />
                    <Label Text="Maaş günü" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding SalaryDay}" Keyboard="Numeric" />
                    <Label Text="Seçilen gün ayda yoksa ayın son günü kullanılır." Style="{StaticResource MutedText}" />
                </VerticalStackLayout>
            </Border>

            <Border>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Maaş Kullanım Şekli" Style="{StaticResource SectionTitle}" />
                    <RadioButton Content="Geçmiş dönemi kapatırım"
                                 GroupName="PaymentAssignmentMode"
                                 IsChecked="{Binding IsPreviousPeriod, Mode=TwoWay}" />
                    <Label Text="{Binding PreviousPeriodDescription}"
                           Margin="34,-8,0,2"
                           Style="{StaticResource MutedText}" />
                    <RadioButton Content="Gelecek dönemi karşılarım"
                                 GroupName="PaymentAssignmentMode"
                                 IsChecked="{Binding IsUpcomingPeriod, Mode=TwoWay}" />
                    <Label Text="{Binding UpcomingPeriodDescription}"
                           Margin="34,-8,0,0"
                           Style="{StaticResource MutedText}" />
                    <Label Text="Gerçek kredi, kart ve ödeme vadeleri değişmez; yalnız hangi maaş bütçesinde gösterildikleri değişir."
                           Style="{StaticResource MutedText}" />
                </VerticalStackLayout>
            </Border>

            <Border>
                <VerticalStackLayout Spacing="9">
                    <Label Text="Tahmini Yaşam Bütçesi" Style="{StaticResource SectionTitle}" />
                    <Label Text="Aylık tahmini yaşam bütçesi" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding MonthlyLivingBudget}" Keyboard="Numeric" />
                    <Label Text="Yemek, market, yakıt ve tek tek takip edilmeyen günlük yaşam giderlerinin yaklaşık toplamı." Style="{StaticResource MutedText}" />
                </VerticalStackLayout>
            </Border>

            <Border>
                <VerticalStackLayout Spacing="9">
                    <Label Text="Tahmini Birikim Başlangıcı" Style="{StaticResource SectionTitle}" />
                    <Label Text="Projeksiyon başlangıç birikimi" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding ProjectionStartingSavings}" Keyboard="Numeric" />
                    <Label Text="Bu tutar yalnızca gelecek tahminlerinin başlangıç noktasıdır; gerçek banka bakiyesi olarak takip edilmez." Style="{StaticResource MutedText}" />
                    <Button Text="Ayarları Kaydet" Command="{Binding SaveCommand}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}" TextColor="{StaticResource Error}" />

            <Border>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Hakkında" Style="{StaticResource SectionTitle}" />
                    <Label Text="CoinFlow" FontFamily="OpenSansSemibold" FontSize="20" />
                    <Label Text="{Binding BuildChannel}" Style="{StaticResource MutedText}" />
                    <Label Text="{Binding VersionText}" />
                    <Label Text="{Binding CommitText}" IsVisible="{Binding IsDevelopment}" />
                    <Label Text="{Binding BuildText}" IsVisible="{Binding IsDevelopment}" />
                    <Label Text="Veriler yalnızca bu cihazda saklanır." Style="{StaticResource MutedText}" />
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding IsDevelopment}" BackgroundColor="{StaticResource SoftPink}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Development Verisi" Style="{StaticResource SectionTitle}" />
                    <Label Text="Development veritabanını temizler, schema migration'larını çalıştırır ve canonical seed'i yeniden yükler." Style="{StaticResource MutedText}" />
                    <Button Text="Development verisini sıfırla ve seed'i yeniden yükle"
                            Clicked="OnResetDevelopmentDataClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
