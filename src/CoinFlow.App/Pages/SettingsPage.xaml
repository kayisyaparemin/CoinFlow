<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoinFlow.App.Pages.SettingsPage"
             Title="Ayarlar">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,36" Spacing="16">
            <Label Text="PROJEKSİYON AYARLARI" Style="{StaticResource Eyebrow}" />
            <Label Text="Ayarlar" Style="{StaticResource PageTitle}" />

            <Border>
                <VerticalStackLayout Spacing="9">
                    <Label Text="Maaş Dönemi" Style="{StaticResource SectionTitle}" />
                    <Label Text="Maaş günü" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding SalaryDay}" Keyboard="Numeric" />
                    <Label Text="Seçilen gün ayda yoksa ayın son günü kullanılır." Style="{StaticResource MutedText}" />
                </VerticalStackLayout>
            </Border>

            <Border>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Maaş Kullanım Düzeni" Style="{StaticResource SectionTitle}" />
                    <Label Text="Mevcut düzen" Style="{StaticResource MutedText}" />
                    <Label Text="{Binding CurrentStrategyText}" FontFamily="OpenSansSemibold" FontSize="17" />
                    <Label Text="{Binding CurrentStrategySinceText}" Style="{StaticResource MutedText}" />
                    <VerticalStackLayout IsVisible="{Binding HasPendingStrategy}" Spacing="3">
                        <Label Text="Planlanan değişiklik" Style="{StaticResource MutedText}" />
                        <Label Text="{Binding PendingStrategyText}" FontFamily="OpenSansSemibold" />
                        <Button Text="Planlanan değişikliği sil"
                                Clicked="OnDeletePendingStrategyClicked" />
                    </VerticalStackLayout>
                    <Button Text="Düzeni Değiştir"
                            IsVisible="{Binding CanManageStrategy}"
                            Clicked="OnChangeStrategyClicked" />
                    <Button Text="Maaş Ekle ve Düzeni Seç"
                            IsVisible="{Binding HasNoStrategy}"
                            Command="{Binding OpenCommitmentsCommand}" />
                    <Label Text="Gerçek kredi, kart ve ödeme vadeleri değişmez; yeni kayıt yalnız seçilen maaştan sonraki bütçe atamalarını etkiler."
                           Style="{StaticResource MutedText}" />
                </VerticalStackLayout>
            </Border>

            <Border>
                <VerticalStackLayout Spacing="9">
                    <Label Text="Düzen Geçmişi" Style="{StaticResource SectionTitle}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding StrategyHistory}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <Label Text="{Binding EffectiveDate}" FontFamily="OpenSansSemibold" />
                                    <Label Grid.Column="1" Text="Planlandı" IsVisible="{Binding IsFuture}" Style="{StaticResource MutedText}" />
                                    <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Mode}" />
                                    <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Note}" Style="{StaticResource MutedText}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="Bu geçmiş bilgilendirme amaçlıdır. Her yeni karar seçilen maaş tarihinde yeni bir kayıt oluşturur; önceki kararlar değiştirilmez."
                           Style="{StaticResource MutedText}" />
                </VerticalStackLayout>
            </Border>

            <Border>
                <VerticalStackLayout Spacing="9">
                    <Label Text="Tahmini Yaşam Bütçesi" Style="{StaticResource SectionTitle}" />
                    <Label Text="Aylık tahmini yaşam bütçesi" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding MonthlyLivingBudget}" Keyboard="Numeric" />
                    <Label Text="Yemek, market, yakıt ve tek tek takip edilmeyen günlük yaşam giderlerinin yaklaşık toplamı." Style="{StaticResource MutedText}" />
                </VerticalStackLayout>
            </Border>

            <Border>
                <VerticalStackLayout Spacing="9">
                    <Label Text="Tahmini Birikim Başlangıcı" Style="{StaticResource SectionTitle}" />
                    <Label Text="Projeksiyon başlangıç birikimi" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding ProjectionStartingSavings}" Keyboard="Numeric" />
                    <Label Text="Bu tutar yalnızca gelecek tahminlerinin başlangıç noktasıdır; gerçek banka bakiyesi olarak takip edilmez." Style="{StaticResource MutedText}" />
                    <Label Text="Planlama başlangıç tarihi" Style="{StaticResource FieldLabel}" />
                    <Label Text="{Binding ProjectionAnchorText}" FontFamily="OpenSansSemibold" />
                    <Label Text="Bu kalıcı snapshot sınırıdır; banka bakiyesi veya günlük harcama takibi değildir." Style="{StaticResource MutedText}" />
                    <Button Text="Ayarları Kaydet" Command="{Binding SaveCommand}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}" TextColor="{StaticResource Error}" />

            <Border>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Hakkında" Style="{StaticResource SectionTitle}" />
                    <Label Text="CoinFlow" FontFamily="OpenSansSemibold" FontSize="20" />
                    <Label Text="{Binding BuildChannel}" Style="{StaticResource MutedText}" />
                    <Label Text="{Binding VersionText}" />
                    <Label Text="{Binding CommitText}" IsVisible="{Binding IsDevelopment}" />
                    <Label Text="{Binding BuildText}" IsVisible="{Binding IsDevelopment}" />
                    <Label Text="Veriler yalnızca bu cihazda saklanır." Style="{StaticResource MutedText}" />
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding IsDevelopment}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Development Verisi" Style="{StaticResource SectionTitle}" />
                    <Border BackgroundColor="{StaticResource SoftPink}" Padding="12">
                        <VerticalStackLayout Spacing="7">
                            <Label Text="Verileri Sil" FontFamily="OpenSansSemibold" />
                            <Label Text="Tüm kullanıcı finans verilerini siler ve uygulamayı boş başlangıç durumuna döndürür."
                                   Style="{StaticResource MutedText}" />
                            <Button Text="Verileri Sil"
                                    Clicked="OnClearDevelopmentDataClicked"
                                    BackgroundColor="{StaticResource SoftPink}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border BackgroundColor="{StaticResource SoftSky}" Padding="12">
                        <VerticalStackLayout Spacing="7">
                            <Label Text="Seed Data Yükle" FontFamily="OpenSansSemibold" />
                            <Label Text="Canonical development verisini boş veya mevcut development veritabanına yükler. Tekrar çalıştırmak duplicate üretmez."
                                   Style="{StaticResource MutedText}" />
                            <Button Text="Seed Data Yükle"
                                    Clicked="OnLoadCanonicalSeedClicked" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
