<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoinFlow.App.Pages.CommitmentsPage"
             Title="Gelir &amp; Ödemeler">
    <ScrollView x:Name="PageScroll">
        <VerticalStackLayout Padding="20,18,20,36" Spacing="16">
            <Label Text="FİNANSAL KAYITLAR" Style="{StaticResource Eyebrow}" />
            <Label Text="Gelir &amp; Ödemeler" Style="{StaticResource PageTitle}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="Gelirler"
                        Command="{Binding ShowIncomeCommand}"
                        BackgroundColor="{StaticResource SoftSky}" />
                <Button Grid.Column="1"
                        Text="Ödemeler"
                        Command="{Binding ShowPaymentsCommand}"
                        BackgroundColor="{StaticResource SoftPink}" />
            </Grid>

            <Border>
                <VerticalStackLayout Spacing="9">
                    <Label Text="+ Yeni Kayıt" Style="{StaticResource SectionTitle}" />
                    <Label Text="Önce kayıt türünü seç" Style="{StaticResource MutedText}" />
                    <Picker ItemsSource="{Binding RecordTypes}"
                            SelectedItem="{Binding SelectedRecordType}" />

                    <Label Text="Ad / açıklama" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Name}" Placeholder="Kayıt adı" />

                    <VerticalStackLayout IsVisible="{Binding IsSalary}" Spacing="7">
                        <Label Text="Maaş tutarı" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding Amount}" Keyboard="Numeric" />
                        <Label Text="Geçerlilik tarihi" Style="{StaticResource FieldLabel}" />
                        <DatePicker Date="{Binding EffectiveDate}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsOtherIncome}" Spacing="7">
                        <Label Text="Gelir tutarı" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding Amount}" Keyboard="Numeric" />
                        <Label Text="Exact gelir tarihi" Style="{StaticResource FieldLabel}" />
                        <DatePicker Date="{Binding EffectiveDate}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsLoan}" Spacing="7">
                        <Label Text="Banka" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding Bank}" />
                        <Label Text="Aylık ödeme" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding Amount}" Keyboard="Numeric" />
                        <Label Text="Ödeme günü" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding PaymentDay}" Keyboard="Numeric" />
                        <Label Text="Exact ilk / sonraki ödeme tarihi" Style="{StaticResource FieldLabel}" />
                        <DatePicker Date="{Binding NextPaymentDate}" />
                        <Label Text="Kalan taksit sayısı" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding InstallmentCount}" Keyboard="Numeric" />
                        <Label Text="Kalan borç (bilgi amaçlı)" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding RemainingDebt}" Keyboard="Numeric" />
                        <Label Text="Erken kapama (opsiyonel)" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding EarlyClosureAmount}" Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsPlan}" Spacing="8">
                        <Label Text="Exact Ödemeler" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6">
                            <DatePicker Date="{Binding PlanPaymentDate}" />
                            <Entry Grid.Column="1" Text="{Binding PlanPaymentAmount}" Placeholder="Tutar" Keyboard="Numeric" />
                            <Button Grid.Column="2" Text="Ekle" Command="{Binding AddPlanPaymentCommand}" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding PlanInstallments}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto,Auto" Padding="8">
                                        <Label Text="{Binding DateText}" />
                                        <Label Grid.Column="1" Text="{Binding AmountText}" />
                                        <Button Grid.Column="2"
                                                Text="Sil"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnRemovePlanPaymentClicked"
                                                MinimumHeightRequest="36"
                                                Padding="10,4" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsCard}" Spacing="8">
                        <Label Text="Banka" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding Bank}" />
                        <Label Text="Kart limiti" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding CardLimit}" Keyboard="Numeric" />
                        <Label Text="Devreden bakiye" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding CarriedBalance}" Keyboard="Numeric" />
                        <Label Text="Ekstreleşmemiş harcama" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding UnbilledSpending}" Keyboard="Numeric" />
                        <Label Text="Bakiye referans tarihi" Style="{StaticResource FieldLabel}" />
                        <DatePicker Date="{Binding CardBalanceDate}" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="7">
                            <VerticalStackLayout>
                                <Label Text="Kesim günü" Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding ClosingDay}" Keyboard="Numeric" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Son ödeme günü" Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding DueDay}" Keyboard="Numeric" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2">
                                <Label Text="Asgari %" Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding MinimumRate}" Keyboard="Numeric" />
                            </VerticalStackLayout>
                        </Grid>

                        <Label Text="Ödeme şekli" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding PaymentStrategies}" SelectedItem="{Binding SelectedPaymentStrategy}" />
                        <Entry Text="{Binding FixedPaymentAmount}"
                               IsVisible="{Binding IsFixedPaymentStrategy}"
                               Placeholder="Sabit ödeme tutarı"
                               Keyboard="Numeric" />

                        <Label Text="Projeksiyon varsayımı" Style="{StaticResource FieldLabel}" />
                        <Picker ItemsSource="{Binding ProjectionFallbackStrategies}" SelectedItem="{Binding SelectedProjectionFallbackStrategy}" />
                        <Entry Text="{Binding ProjectionFallbackFixedAmount}"
                               IsVisible="{Binding IsFixedProjectionFallback}"
                               Placeholder="Sabit projeksiyon tutarı"
                               Keyboard="Numeric" />
                        <Label Text="Her ekstrede sor ile projeksiyon varsayımı birbirinden bağımsızdır." Style="{StaticResource MutedText}" />

                        <Label Text="Gelecek Exact Posting Charge'ları" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6">
                            <DatePicker Date="{Binding CardChargeDate}" />
                            <Entry Grid.Column="1" Text="{Binding CardChargeAmount}" Placeholder="Tutar" Keyboard="Numeric" />
                            <Button Grid.Column="2" Text="Ekle" Command="{Binding AddCardChargeCommand}" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CardFutureCharges}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto,Auto"
                                          RowDefinitions="Auto,Auto"
                                          Padding="8">
                                        <Label Text="{Binding DateText}" />
                                        <Label Grid.Column="1" Text="{Binding AmountText}" />
                                        <Button Grid.Column="2"
                                                Text="Sil"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnRemoveCardChargeClicked"
                                                MinimumHeightRequest="36"
                                                Padding="10,4" />
                                        <Label Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding Description}"
                                               IsVisible="{Binding HasDescription}"
                                               Style="{StaticResource MutedText}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label Text="Due-Date Ödeme Planı" Style="{StaticResource SectionTitle}" />
                        <Label Text="Belirli bir statement için asgari, tamamı veya özel tutar override'ı." Style="{StaticResource MutedText}" />
                        <DatePicker Date="{Binding CardPaymentPlanDate}" />
                        <Picker ItemsSource="{Binding PaymentPlanTypes}" SelectedItem="{Binding SelectedPaymentPlanType}" />
                        <Entry Text="{Binding CardPaymentPlanAmount}"
                               IsVisible="{Binding IsFixedPaymentPlan}"
                               Placeholder="Özel ödeme tutarı"
                               Keyboard="Numeric" />
                        <Button Text="Ödeme Planına Ekle" Command="{Binding AddCardPaymentPlanCommand}" Style="{StaticResource SecondaryButton}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CardPaymentPlans}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,*,Auto" Padding="8">
                                        <Label Text="{Binding DateText}" />
                                        <Label Grid.Column="1" Text="{Binding PaymentText}" />
                                        <Button Grid.Column="2"
                                                Text="Daha sonra"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnRemoveCardPaymentPlanClicked"
                                                MinimumHeightRequest="36"
                                                Padding="10,4" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsLargeExpense}" Spacing="7">
                        <Label Text="Tutar" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding Amount}" Keyboard="Numeric" />
                        <Label Text="Exact ödeme tarihi" Style="{StaticResource FieldLabel}" />
                        <DatePicker Date="{Binding EffectiveDate}" />
                        <Label Text="Not" Style="{StaticResource FieldLabel}" />
                        <Editor Text="{Binding Note}" AutoSize="TextChanges" />
                    </VerticalStackLayout>

                    <Button Text="{Binding SaveButtonText}" Command="{Binding SaveCommand}" />
                    <Button Text="Kart düzenlemeyi iptal et"
                            IsVisible="{Binding IsEditingCard}"
                            Command="{Binding CancelEditingCardCommand}"
                            Style="{StaticResource SecondaryButton}" />
                    <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}" TextColor="{StaticResource Error}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Gelirler" Style="{StaticResource SectionTitle}" IsVisible="{Binding IsIncomeSection}" />
            <Label Text="Ödemeler" Style="{StaticResource SectionTitle}" IsVisible="{Binding IsPaymentSection}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="9">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border>
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="17" />
                                    <Label Grid.Column="1" Text="{Binding Amount}" FontFamily="OpenSansSemibold" />
                                </Grid>
                                <Label Text="{Binding Subtitle}" Style="{StaticResource MutedText}" />
                                <Label Text="{Binding Badge}" FontSize="12" />
                                <HorizontalStackLayout Spacing="8">
                                    <Button Text="Kart Detayı / Plan"
                                            IsVisible="{Binding CanEditCard}"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnEditCardClicked"
                                            MinimumHeightRequest="38"
                                            Padding="12,5" />
                                    <Button Text="Sil"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnDeleteClicked"
                                            MinimumHeightRequest="38"
                                            Padding="12,5"
                                            BackgroundColor="{StaticResource SoftPink}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
