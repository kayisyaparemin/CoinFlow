<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoinFlow.App.Pages.SalaryPeriodDetailPage"
             Title="Dönem Detayı"
             Shell.FlyoutBehavior="Disabled"
             Shell.NavBarIsVisible="True">
    <ContentPage.Resources>
        <Style x:Key="HeroMetricBorder" TargetType="Border">
            <Setter Property="Padding" Value="13" />
            <Setter Property="MinimumHeightRequest" Value="96" />
            <Setter Property="BackgroundColor" Value="{StaticResource ProjectionSurface}" />
            <Style.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsIncome}" Value="True">
                    <Setter Property="BackgroundColor" Value="{StaticResource PositiveSurface}" />
                </DataTrigger>
                <DataTrigger TargetType="Border" Binding="{Binding IsMandatory}" Value="True">
                    <Setter Property="BackgroundColor" Value="{StaticResource DebtSurface}" />
                </DataTrigger>
                <DataTrigger TargetType="Border" Binding="{Binding IsSavings}" Value="True">
                    <Setter Property="BackgroundColor" Value="{StaticResource PositiveSurface}" />
                </DataTrigger>
                <DataTrigger TargetType="Border" Binding="{Binding IsDeficit}" Value="True">
                    <Setter Property="BackgroundColor" Value="{StaticResource DeficitSurface}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HeroMetricValue" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="23" />
            <Setter Property="TextColor" Value="{StaticResource ProjectionText}" />
            <Style.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding IsIncome}" Value="True">
                    <Setter Property="TextColor" Value="{StaticResource PositiveText}" />
                </DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding IsMandatory}" Value="True">
                    <Setter Property="TextColor" Value="{StaticResource DebtText}" />
                </DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding IsSavings}" Value="True">
                    <Setter Property="TextColor" Value="{StaticResource PositiveText}" />
                </DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding IsDeficit}" Value="True">
                    <Setter Property="TextColor" Value="{StaticResource DeficitText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SemanticAmount" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="TextColor" Value="{StaticResource Ink}" />
            <Style.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding IsIncome}" Value="True">
                    <Setter Property="TextColor" Value="{StaticResource PositiveText}" />
                </DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding IsMandatory}" Value="True">
                    <Setter Property="TextColor" Value="{StaticResource DebtText}" />
                </DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding IsSavings}" Value="True">
                    <Setter Property="TextColor" Value="{StaticResource PositiveText}" />
                </DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding IsDeficit}" Value="True">
                    <Setter Property="TextColor" Value="{StaticResource DeficitText}" />
                </DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding IsInterest}" Value="True">
                    <Setter Property="TextColor" Value="{StaticResource InterestText}" />
                </DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding IsExpense}" Value="True">
                    <Setter Property="TextColor" Value="{StaticResource ExpenseText}" />
                </DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding IsProjection}" Value="True">
                    <Setter Property="TextColor" Value="{StaticResource ProjectionText}" />
                </DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding IsTotal}" Value="True">
                    <Setter Property="FontSize" Value="16" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DeltaAmount" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="TextColor" Value="{StaticResource Muted}" />
            <Style.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding IsFavorable}" Value="True">
                    <Setter Property="TextColor" Value="{StaticResource PositiveText}" />
                </DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding IsUnfavorable}" Value="True">
                    <Setter Property="TextColor" Value="{StaticResource DeficitText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PaymentAmount" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="TextColor" Value="{StaticResource DebtText}" />
            <Style.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding IsExpense}" Value="True">
                    <Setter Property="TextColor" Value="{StaticResource ExpenseText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,42" Spacing="22">
            <VerticalStackLayout IsVisible="{Binding HasDetail}" Spacing="22">
                <VerticalStackLayout Spacing="8">
                    <Label Text="DÖNEM DETAYI" Style="{StaticResource Eyebrow}" />
                    <Label Text="{Binding Detail.SalaryTitle}"
                           Style="{StaticResource PageTitle}"
                           FontSize="28" />
                    <Label Text="{Binding Detail.PaymentWindowText}"
                           Style="{StaticResource MutedText}"
                           FontSize="13" />
                    <FlexLayout Wrap="Wrap" Direction="Row">
                        <Border Padding="10,5"
                                Margin="0,0,7,4"
                                BackgroundColor="{StaticResource ProjectionSurface}">
                            <Label Text="{Binding Detail.AssignmentBadge}"
                                   FontSize="11"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource ProjectionText}" />
                        </Border>
                        <Border Padding="10,5"
                                Margin="0,0,7,4"
                                IsVisible="{Binding Detail.IsStrategyTransition}"
                                BackgroundColor="{StaticResource WarningSurface}">
                            <Label Text="Düzen değişikliği dönemi"
                                   FontSize="11"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource WarningText}" />
                        </Border>
                    </FlexLayout>
                </VerticalStackLayout>

                <Border IsVisible="{Binding Detail.IsSimulationScenario}"
                        BackgroundColor="{StaticResource SoftSky}">
                    <VerticalStackLayout Spacing="13">
                        <Label Text="Bu dönemde ne olacak?"
                               Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                              RowSpacing="8">
                            <Label Text="Dönem başı durumu" Style="{StaticResource MutedText}" />
                            <Label Grid.Column="1"
                                   Text="{Binding Detail.OpeningSummary.AmountText}"
                                   FontFamily="OpenSansSemibold" />
                            <Label Grid.Row="1" Text="Dönem gelirleri" Style="{StaticResource MutedText}" />
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding Detail.IncomeSummary.AmountText}"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource PositiveText}" />
                            <Label Grid.Row="2" Text="Bu dönem gereken" Style="{StaticResource MutedText}" />
                            <Label Grid.Row="2"
                                   Grid.Column="1"
                                   Text="{Binding Detail.PeriodNeedSummary.AmountText}"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource DebtText}" />
                            <Label Grid.Row="3" Text="{Binding Detail.IncomeCoverageSummary.Label}" Style="{StaticResource MutedText}" />
                            <Label Grid.Row="3"
                                   Grid.Column="1"
                                   Text="{Binding Detail.IncomeCoverageSummary.AmountText}"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource PositiveText}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding Detail.IncomeCoverageSummary.IsDeficit}"
                                                 Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource DeficitText}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <BoxView Grid.Row="4"
                                     Grid.ColumnSpan="2"
                                     HeightRequest="1"
                                     Color="{StaticResource Line}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Dönem sonu tahmini durum"
                                   FontFamily="OpenSansSemibold" />
                            <Label Grid.Column="1"
                                   Text="{Binding Detail.EndingSummary.AmountText}"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource ProjectionText}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding Detail.EndingSummary.IsDeficit}"
                                                 Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource DeficitText}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                        <Label Text="{Binding Detail.IncomeCoverageMessage}"
                               IsVisible="{Binding Detail.HasIncomeCoverageMessage}"
                               Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding Detail.IsSimulationScenario}">
                    <VerticalStackLayout Spacing="13">
                        <Label Text="Bu Dönem Gereken"
                               Style="{StaticResource SectionTitle}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Detail.NeedBreakdownRows}"
                                             Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="7">
                                        <BoxView HeightRequest="1"
                                                 Color="{StaticResource Line}"
                                                 IsVisible="{Binding IsTotal}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <Label Text="{Binding Label}" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding AmountText}"
                                                   Style="{StaticResource SemanticAmount}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding Detail.HasComparison}"
                        BackgroundColor="{StaticResource ProjectionSurface}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Dönem Karşılaştırması"
                               Style="{StaticResource SectionTitle}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Detail.ComparisonRows}"
                                             Spacing="9">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <Label Text="{Binding Label}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding DifferenceText}"
                                               Style="{StaticResource DeltaAmount}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding Detail.HasComparison}">
                    <VerticalStackLayout Spacing="13">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                            <Label Text="Karşılaştırma Özeti"
                                   Style="{StaticResource SectionTitle}" />
                            <Label Grid.Column="1" Text="ÖNCE" Style="{StaticResource Eyebrow}" />
                            <Label Grid.Column="2" Text="SONRA" Style="{StaticResource Eyebrow}" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Detail.ComparisonRows}"
                                             Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="{Binding Label}" FontFamily="OpenSansSemibold" />
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                            <VerticalStackLayout>
                                                <Label Text="Önce" Style="{StaticResource MutedText}" />
                                                <Label Text="{Binding BaselineText}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Text="Sonra" Style="{StaticResource MutedText}" />
                                                <Label Text="{Binding ScenarioText}" FontFamily="OpenSansSemibold" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2">
                                                <Label Text="Fark" Style="{StaticResource MutedText}" />
                                                <Label Text="{Binding DifferenceText}"
                                                       Style="{StaticResource DeltaAmount}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="10"
                      RowSpacing="10"
                      IsVisible="{Binding Detail.IsStandardProjection}">
                    <Border Grid.Row="0"
                            Grid.Column="0"
                            BindingContext="{Binding Detail.IncomeSummary}"
                            Style="{StaticResource HeroMetricBorder}">
                        <VerticalStackLayout Spacing="7">
                            <Label Text="{Binding Label}" Style="{StaticResource Eyebrow}" />
                            <Label Text="{Binding AmountText}" Style="{StaticResource HeroMetricValue}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="0"
                            Grid.Column="1"
                            BindingContext="{Binding Detail.MandatorySummary}"
                            Style="{StaticResource HeroMetricBorder}">
                        <VerticalStackLayout Spacing="7">
                            <Label Text="{Binding Label}" Style="{StaticResource Eyebrow}" />
                            <Label Text="{Binding AmountText}" Style="{StaticResource HeroMetricValue}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1"
                            Grid.Column="0"
                            BindingContext="{Binding Detail.SavingsSummary}"
                            Style="{StaticResource HeroMetricBorder}">
                        <VerticalStackLayout Spacing="7">
                            <Label Text="{Binding Label}" Style="{StaticResource Eyebrow}" />
                            <Label Text="{Binding AmountText}" Style="{StaticResource HeroMetricValue}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1"
                            Grid.Column="1"
                            BindingContext="{Binding Detail.EndingSummary}"
                            Style="{StaticResource HeroMetricBorder}">
                        <VerticalStackLayout Spacing="7">
                            <Label Text="{Binding Label}" Style="{StaticResource Eyebrow}" />
                            <Label Text="{Binding AmountText}" Style="{StaticResource HeroMetricValue}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border IsVisible="{Binding Detail.IsStandardProjection}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Dönem Akışı" Style="{StaticResource SectionTitle}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Detail.FlowRows}"
                                             Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="8">
                                        <BoxView HeightRequest="1"
                                                 Color="{StaticResource Line}"
                                                 IsVisible="{Binding IsTotal}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <Label Text="{Binding Label}" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding AmountText}"
                                                   Style="{StaticResource SemanticAmount}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding Detail.HasDeficit}"
                        BackgroundColor="{StaticResource DeficitSurface}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Önceki dönemden devreden açık"
                               Style="{StaticResource SectionTitle}"
                               TextColor="{StaticResource DeficitText}" />
                        <Label Text="{Binding Detail.Deficit.OpeningDeficitText}"
                               FontFamily="OpenSansSemibold"
                               FontSize="25"
                               TextColor="{StaticResource DeficitText}" />
                        <Label Text="Bu maaşın önce bu açığı kapatması gerekiyor."
                               TextColor="{StaticResource InkSoft}" />
                        <Label Text="{Binding Detail.Deficit.CoveredText}"
                               IsVisible="{Binding Detail.Deficit.HasCoveredAmount}"
                               Style="{StaticResource MutedText}" />
                        <Label Text="{Binding Detail.Deficit.Message}"
                               FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource DeficitText}" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding Detail.HasMandatoryRows}" Spacing="10">
                    <Label Text="Zorunlu Ödemeler" Style="{StaticResource SectionTitle}" />
                    <Border>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Detail.MandatoryRows}"
                                             Spacing="11">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="6,*,Auto" ColumnSpacing="11">
                                        <BoxView Color="{StaticResource DebtText}" CornerRadius="3" />
                                        <Label Grid.Column="1" Text="{Binding Label}" />
                                        <Label Grid.Column="2"
                                               Text="{Binding AmountText}"
                                               Style="{StaticResource SemanticAmount}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding Detail.HasInterestRows}" Spacing="10">
                    <Label Text="Faiz Yükü" Style="{StaticResource SectionTitle}" />
                    <Border BackgroundColor="{StaticResource InterestSurface}">
                        <VerticalStackLayout Spacing="12">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Detail.InterestRows}"
                                                 Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="7">
                                            <BoxView HeightRequest="1"
                                                     Color="{StaticResource Line}"
                                                     IsVisible="{Binding IsTotal}" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <Label Text="{Binding Label}" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding AmountText}"
                                                       Style="{StaticResource SemanticAmount}" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <VerticalStackLayout IsVisible="{Binding Detail.HasCardInterestRows}"
                                                 Spacing="7">
                                <Label Text="Kart bazında" Style="{StaticResource Eyebrow}" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Detail.CardInterestRows}"
                                                     Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding Label}" Style="{StaticResource MutedText}" />
                                                <Label Grid.Column="1" Text="{Binding AmountText}" FontSize="12" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding Detail.HasTransitionRows}" Spacing="10">
                    <Label Text="Düzen Değişikliği" Style="{StaticResource SectionTitle}" />
                    <Border BackgroundColor="{StaticResource ProjectionSurface}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Detail.TransitionRows}"
                                             Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="7">
                                        <BoxView HeightRequest="1"
                                                 Color="{StaticResource Line}"
                                                 IsVisible="{Binding IsTotal}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Label}" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding AmountText}"
                                                   Style="{StaticResource SemanticAmount}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding Detail.HasPayments}" Spacing="10">
                    <Label Text="Ödeme ayrıntıları" Style="{StaticResource SectionTitle}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Detail.PaymentRows}"
                                         Spacing="9">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14">
                                    <VerticalStackLayout Spacing="9">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border Padding="8,4"
                                                    BackgroundColor="{StaticResource ProjectionSurface}">
                                                <Label Text="{Binding DateText}"
                                                       FontSize="11"
                                                       FontFamily="OpenSansSemibold"
                                                       TextColor="{StaticResource ProjectionText}" />
                                            </Border>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="16"
                                                   VerticalTextAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <Label Text="{Binding Category}"
                                                   Style="{StaticResource MutedText}" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding AmountText}"
                                                   Style="{StaticResource PaymentAmount}" />
                                        </Grid>
                                        <Label Text="{Binding AssignedSalaryText}"
                                               IsVisible="{Binding HasAssignedSalary}"
                                               Style="{StaticResource MutedText}" />
                                        <FlexLayout Wrap="Wrap" Direction="Row">
                                            <Border Padding="9,4"
                                                    Margin="0,0,6,3"
                                                    IsVisible="{Binding IsBeforeFundingSalary}"
                                                    BackgroundColor="{StaticResource WarningSurface}">
                                                <Label Text="Maaştan Önce"
                                                       FontSize="11"
                                                       TextColor="{StaticResource WarningText}" />
                                            </Border>
                                            <Border Padding="9,4"
                                                    Margin="0,0,6,3"
                                                    IsVisible="{Binding IsEstimated}"
                                                    BackgroundColor="{StaticResource ProjectionSurface}">
                                                <Label Text="Tahmini"
                                                       FontSize="11"
                                                       TextColor="{StaticResource ProjectionText}" />
                                            </Border>
                                            <Border Padding="9,4"
                                                    Margin="0,0,6,3"
                                                    IsVisible="{Binding IsUndetermined}"
                                                    BackgroundColor="{StaticResource WarningSurface}">
                                                <Label Text="Plan Bekliyor"
                                                       FontSize="11"
                                                       TextColor="{StaticResource WarningText}" />
                                            </Border>
                                        </FlexLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="Maaştan Önce: Son ödeme tarihi, bu ödemeyi karşılayan maaştan önce."
                           IsVisible="{Binding Detail.HasBeforeSalaryPayments}"
                           Style="{StaticResource MutedText}" />
                    <Label Text="Tahmini: Gerçek kart ödeme planı girilmediği için seçtiğin gelecek hesaplama tercihi kullanıldı."
                           IsVisible="{Binding Detail.HasEstimatedPayments}"
                           Style="{StaticResource MutedText}" />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsDevelopment}" Spacing="10">
                    <Label Text="Hesaplama Detayı (DEV)" Style="{StaticResource SectionTitle}" />
                    <Border BackgroundColor="{StaticResource SoftSky}">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Detail.DebugRows}"
                                             Spacing="7">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <Label Text="{Binding Label}" FontSize="11" />
                                        <Label Grid.Column="1"
                                               Text="{Binding AmountText}"
                                               FontSize="11"
                                               FontFamily="OpenSansSemibold" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Border IsVisible="{Binding HasStatus}"
                    BackgroundColor="{StaticResource DeficitSurface}">
                <Label Text="{Binding StatusMessage}"
                       TextColor="{StaticResource DeficitText}" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
