<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CoinFlow.App.ViewModels"
             x:Class="CoinFlow.App.Pages.ExpensePage"
             x:DataType="vm:ExpenseViewModel"
             Title="Harcama">
    <ScrollView>
        <VerticalStackLayout Padding="20,28,20,40" Spacing="14">
            <Label Text="HIZLI KAYIT" Style="{StaticResource Eyebrow}" />
            <Label Text="Harcama ekle" Style="{StaticResource PageTitle}" />
            <Label Text="Nakit harcamalar coin havuzunu şimdi, kart harcamaları sonraki kart tahminini etkiler." Style="{StaticResource MutedText}" />

            <Label Text="Tutar" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding Amount}" Placeholder="0,00" Keyboard="Numeric" />
            <Label Text="Tarih" Style="{StaticResource FieldLabel}" />
            <DatePicker Date="{Binding ExpenseDate}" Format="dd.MM.yyyy" />
            <Label Text="Kategori" Style="{StaticResource FieldLabel}" />
            <Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />
            <Label Text="Ödeme tipi" Style="{StaticResource FieldLabel}" />
            <Picker ItemsSource="{Binding PaymentTypes}" SelectedItem="{Binding SelectedPaymentType}" />

            <VerticalStackLayout IsVisible="{Binding IsCreditCard}" Spacing="8">
                <Label Text="Kredi kartı" Style="{StaticResource FieldLabel}" />
                <Picker ItemsSource="{Binding CreditCards}" SelectedItem="{Binding SelectedCreditCard}" Title="Kart seç" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsInstallment}" Spacing="8">
                <Label Text="Taksit sayısı" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding InstallmentCount}" Keyboard="Numeric" />
                <Label Text="İlk ödeme" Style="{StaticResource FieldLabel}" />
                <DatePicker Date="{Binding FirstInstallmentDate}" Format="dd.MM.yyyy" />
            </VerticalStackLayout>

            <Label Text="Not" Style="{StaticResource FieldLabel}" />
            <Editor Text="{Binding Note}" Placeholder="Örn. araba tamiri" AutoSize="TextChanges" MinimumHeightRequest="90" />
            <Button Text="Harcamayı kaydet" Command="{Binding SaveCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Border IsVisible="{Binding HasStatus}" BackgroundColor="{StaticResource Lime}" StrokeThickness="0">
                <Label Text="{Binding StatusMessage}" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
